# ---- Django ----
# Generate a real key for prod:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=dev-insecure-change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SETTINGS_MODULE=config.settings.dev

# ---- Database ----
# In dev: leave unset to use a local SQLite file (db.sqlite3).
# Set to a Postgres URL to use Postgres locally or in prod:
# DATABASE_URL=postgres://user:password@host:5432/dbname

# ---- SMS ----
# Backend: console (prints to stdout) | locmem (in-memory, for tests) | twilio (production)
SMS_BACKEND=console

# Canonical https:// origin for SMS edit-links (required in PROD when SMS_BACKEND=twilio;
# prod.py fails closed without it). Example:
# PUBLIC_BASE_URL=https://cwac.example.com

# Only required when SMS_BACKEND=twilio:
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_MESSAGING_SERVICE_SID=MGxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx  # prod sends + Advanced Opt-Out
# TWILIO_FROM_NUMBER=+15555550100   # local-dev/console fallback only (prod sends via the Service)

# ---- Bootstrap admin (prod only; used by `manage.py ensure_admin` in Phase 11) ----
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=changeme
# ADMIN_EMAIL=admin@example.com
